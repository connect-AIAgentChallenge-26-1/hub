{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noticepilot.local/schemas/incremental-source-plan.schema.json",
  "title": "NoticePilot Incremental Source Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runtimeVersion", "sourceNoticeId", "sourceIdentityKey", "previousContentHash", "incomingContentHash", "action", "persistSourceState", "enqueueExtraction", "requiresEventReconciliation", "requiresFeedRebuild", "reasonCodes"],
  "properties": {
    "schemaVersion": {"const": "noticepilot.incrementalSourcePlan.v0.1"},
    "runtimeVersion": {"const": "0.1.0"},
    "sourceNoticeId": {"type": "string", "minLength": 1},
    "sourceIdentityKey": {"type": "string", "minLength": 1},
    "previousContentHash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "incomingContentHash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "action": {"enum": ["insert_and_extract", "reprocess_content_changed", "refresh_metadata_only", "skip_unchanged", "mark_deleted", "retain_last_good_retry"]},
    "persistSourceState": {"type": "boolean"},
    "enqueueExtraction": {"type": "boolean"},
    "requiresEventReconciliation": {"type": "boolean"},
    "requiresFeedRebuild": {"type": "boolean"},
    "reasonCodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}

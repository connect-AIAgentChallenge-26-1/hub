{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "noticepilot.judgmentTrace.v0.1",
  "title": "NoticePilot Layered Judgment Trace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "traceId", "sourceNoticeId", "candidateId", "engineVersions", "judgments", "finalDecision", "metadata"],
  "properties": {
    "schemaVersion": {"const": "noticepilot.judgmentTrace.v0.1"},
    "traceId": {"type": "string", "minLength": 1},
    "sourceNoticeId": {"type": "string", "minLength": 1},
    "candidateId": {"type": ["string", "null"]},
    "engineVersions": {"type": "object", "additionalProperties": {"type": "string"}},
    "judgments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "verdict", "ruleId", "confidence", "inputRefs", "output", "reasonCodes"],
        "properties": {
          "layer": {"type": "string", "enum": ["structure", "temporal", "local_binding", "semantic_classification", "applicability", "publishability", "reconciliation", "subscription_projection", "serialization"]},
          "verdict": {"type": "string", "enum": ["observed", "pass", "classified", "auto_confirmed", "needs_review", "not_calendar_relevant", "filtered", "conflict", "error"]},
          "ruleId": {"type": "string", "minLength": 1},
          "confidence": {"type": "string", "enum": ["high", "medium", "low", "none"]},
          "inputRefs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "output": {"type": "object"},
          "reasonCodes": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "finalDecision": {"type": "object"},
    "metadata": {"type": "object"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noticepilot.local/schemas/persisted-cross-notice-relation.schema.json",
  "title": "NoticePilot persisted cross-notice relation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "relationDecisionId", "registryId", "pairId",
    "candidateIds", "calendarEventIds", "relation", "decisionStatus",
    "mergeAllowed", "mergeApplied", "canonicalCandidateId", "ruleIds",
    "evidence", "persistedAt"
  ],
  "properties": {
    "schemaVersion": {"const": "noticepilot.persistedCrossNoticeRelation.v0.1"},
    "relationDecisionId": {"type": "string", "pattern": "^reldec_[0-9a-f]{32}$"},
    "registryId": {"type": "string"},
    "pairId": {"type": "string"},
    "candidateIds": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "calendarEventIds": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "relation": {"enum": ["distinct", "duplicate", "revision", "extension", "replacement", "needs_review"]},
    "decisionStatus": {"enum": ["approved", "needs_review"]},
    "mergeAllowed": {"type": "boolean"},
    "mergeApplied": {"type": "boolean"},
    "canonicalCandidateId": {"type": ["string", "null"]},
    "ruleIds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "evidence": {"type": "object"},
    "persistedAt": {"type": "string"}
  }
}

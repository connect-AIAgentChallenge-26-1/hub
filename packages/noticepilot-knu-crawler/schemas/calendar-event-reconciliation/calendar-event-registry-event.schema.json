{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noticepilot.local/schemas/calendar-event-registry-event.schema.json",
  "title": "NoticePilot CalendarEvent registry event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "calendarEventId", "idStrategy", "registryId",
    "canonicalCandidateId", "canonicalSourceNoticeId", "sourceCandidateIds",
    "sourceNoticeIds", "relationBasis", "projection", "status",
    "revisionNumber", "sequence", "activeRevisionId", "version",
    "createdAt", "updatedAt", "icsUidMigrationPerformed"
  ],
  "properties": {
    "schemaVersion": {"const": "noticepilot.calendarEventRegistryEvent.v0.1"},
    "calendarEventId": {"type": "string", "pattern": "^evt_[0-9a-f]{32}$"},
    "idStrategy": {"const": "registry_assigned_opaque_v0"},
    "registryId": {"type": "string", "minLength": 1},
    "canonicalCandidateId": {"type": "string", "minLength": 1},
    "canonicalSourceNoticeId": {"type": "string", "minLength": 1},
    "sourceCandidateIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "sourceNoticeIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "relationBasis": {"enum": ["singleton", "duplicate", "extension"]},
    "projection": {"type": "object"},
    "status": {"enum": ["published", "updated", "cancelled", "suppressed"]},
    "revisionNumber": {"type": "integer", "minimum": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "activeRevisionId": {"type": "string", "pattern": "^evrev_[0-9a-f]{32}$"},
    "version": {"type": "integer", "minimum": 0},
    "createdAt": {"type": "string"},
    "updatedAt": {"type": "string"},
    "icsUidMigrationPerformed": {"const": false}
  }
}

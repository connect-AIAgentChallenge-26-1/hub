      "segmentId": "seg-6c18a5513913a168",
      "segmentType": "paragraph",
      "labelText": "",
      "bodyText": "막연한 시작 앞에서 방향을 찾고 싶은 순간,",
      "sourceLocation": {
        "lineIndex": 10,
        "clauseIndex": 0,
        "parentSegmentId": null

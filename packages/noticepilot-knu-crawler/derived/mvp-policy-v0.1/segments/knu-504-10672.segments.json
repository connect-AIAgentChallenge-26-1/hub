      "segmentId": "seg-a406b513183be1de",
      "segmentType": "paragraph",
      "labelText": "",
      "bodyText": "빠르게 흘러가는 하루 속에서 나만의 리듬을 만들고 싶은 순간,",
      "sourceLocation": {
        "lineIndex": 11,

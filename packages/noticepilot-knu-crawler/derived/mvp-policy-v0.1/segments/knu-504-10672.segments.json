    {
      "schemaVersion": "noticepilot.scheduleSegments.v0.3",
      "segmentId": "seg-1fdb7e7105402647",
      "segmentType": "paragraph",
      "labelText": "",
      "bodyText": "이번 전시는 각기 다른 읽기의 이유를 하나의 자리로 연결합니다.",
      "sourceLocation": {
        "lineIndex": 9,
        "clauseIndex": 0,
        "parentSegmentId": null

        "parentSegmentId": null
      },
      "actionSignals": [],
      "audienceSignals": [],
      "dateSpans": [],
      "locallyGrounded": false,
      "text": "본 세션에서는 OECD DAC 보고서를 바탕으로 국제개발협력의 주요 성과와 변화과정을 살펴보고"
    },
    {
      "schemaVersion": "noticepilot.scheduleSegments.v0.3",
      "segmentId": "seg-214ac4376f60e994",
      "segmentType": "paragraph",
      "labelText": "",

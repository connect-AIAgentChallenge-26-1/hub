        "clauseIndex": 0,
        "parentSegmentId": null
      },
      "actionSignals": [],
      "audienceSignals": [],
      "dateSpans": [],
      "locallyGrounded": false,
      "text": "하여 보다 풍성한 독서 경험을 제공합니다."

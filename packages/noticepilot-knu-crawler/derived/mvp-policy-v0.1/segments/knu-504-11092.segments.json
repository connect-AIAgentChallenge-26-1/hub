      "schemaVersion": "noticepilot.scheduleSegments.v0.3",
      "segmentId": "seg-57cf4c12a1c8d508",
      "segmentType": "paragraph",
      "labelText": "",
      "bodyText": "하여 보다 풍성한 독서 경험을 제공합니다.",
      "sourceLocation": {

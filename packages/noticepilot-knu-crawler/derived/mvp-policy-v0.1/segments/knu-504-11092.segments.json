    {
      "schemaVersion": "noticepilot.scheduleSegments.v0.3",
      "segmentId": "seg-074057807310205c",
      "segmentType": "paragraph",
      "labelText": "",
      "bodyText": "일상 속 다양한 순간에 공감과 위로를 전하는",
      "sourceLocation": {
        "lineIndex": 4,
        "clauseIndex": 0,
        "parentSegmentId": null
      },
      "actionSignals": [],
      "audienceSignals": [],
      "dateSpans": [],
      "locallyGrounded": false,
      "text": "일상 속 다양한 순간에 공감과 위로를 전하는"
    },
    {
      "schemaVersion": "noticepilot.scheduleSegments.v0.3",
      "segmentId": "seg-9efd7a6f5f22537e",
      "segmentType": "paragraph",
      "labelText": "",
      "bodyText": "전자책 중심으로 구성",
      "sourceLocation": {
        "lineIndex": 5,
        "clauseIndex": 0,
        "parentSegmentId": null
      },
      "actionSignals": [],
      "audienceSignals": [],
      "dateSpans": [],
      "locallyGrounded": false,
      "text": "전자책 중심으로 구성"

      "segmentId": "seg-edea2a94c83357b8",
      "segmentType": "paragraph",
      "labelText": "",
      "bodyText": "현장에서는 실물도서를 함께 전시",
      "sourceLocation": {
        "lineIndex": 7,
        "clauseIndex": 0,
        "parentSegmentId": null
      },
      "actionSignals": [],
      "audienceSignals": [],
      "dateSpans": [],
      "locallyGrounded": false,
      "text": "현장에서는 실물도서를 함께 전시"

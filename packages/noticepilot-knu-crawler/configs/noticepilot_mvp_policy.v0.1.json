{
  "schemaVersion": "noticepilot.mvpPolicyConfig.v0.1",
  "policyVersion": "noticepilot.studentFirstMvp.v0.1",
  "timezone": "Asia/Seoul",
  "primaryAudience": "student",
  "feeds": {
    "student_default": {
      "label": "학생 기본 피드",
      "enabled": true,
      "description": "학생이 행동해야 하는 일정과 향후 결과 발표 예정일"
    },
    "job_application": {
      "label": "채용 접수 피드",
      "enabled": true,
      "description": "MVP에서 716 채용안내 중 지원 가능한 접수 일정만 분리 제공"
    }
  },
  "boardPolicies": {
    "716": {
      "mode": "application_period_only",
      "publicationDateSource": "detail.publishedAt",
      "applicationPeriodSource": "listMetadata.application_period_start/end"
    }
  },
  "datePolicy": {
    "requireDeterministicDate": true,
    "preserveExplicitRanges": true,
    "coreEndDateInclusive": true,
    "icsEndDateExclusive": true,
    "relativeDate": {
      "publicationDateAliases": [
        "공고일",
        "게시일",
        "등록일"
      ],
      "withinDaysCalculation": "publishedAt_plus_n_calendar_days",
      "forDaysCalculation": "inclusive_window_starting_at_reference",
      "nextDayForDaysCalculation": "inclusive_window_starting_day_after_reference"
    }
  },

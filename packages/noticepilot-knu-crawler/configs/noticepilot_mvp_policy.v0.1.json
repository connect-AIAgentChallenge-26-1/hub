  "academicActionPolicy": {
    "leaveReturn": {
      "preserveAsPeriod": true,
      "splitSharedPeriodIntoActions": true,
      "actionTypes": {
        "leave": "leave_of_absence_application",
        "return": "return_from_leave_application"
      }
    },
    "courseRegistration": {
      "preserveCohortSpecificCandidates": true,
      "supportedActionTypes": [
        "course_registration",
        "preliminary_course_registration",
        "course_registration_change",
        "course_registration_cancellation"
      ],
      "cohortDimensions": [
        "degreeLevels",
        "studentYears",
        "enrollmentStatuses",
        "admissionTypes"
      ],
      "unresolvedMultipleSchedules": "needs_review"
    }
  },
  "subscriptionApplicability": {
    "candidateField": "audienceRules",
    "filterStage": "subscription_feed_builder",
    "matchMode": "all_dimensions",
    "emptyRuleBehavior": "include_for_all_matching_target_actor",
    "mvpProfileDimensions": [
      "campuses",
      "degreeLevel",
      "studentYear",
      "enrollmentStatus"
    ],
    "deferredProfileDimensions": [
      "college",
      "department",
      "major"
    ]
  },
  "structuredScheduleSegmentation": {
    "schemaVersion": "noticepilot.scheduleSegments.v0.3",
    "enabled": true,
    "unitTypes": [
      "title",
      "paragraph",
      "list_item",
      "label_value",
      "table_row",
      "continuation"
    ],
    "overlappingSlidingWindows": false,
    "labelOwnership": "nearest local structural unit",
    "continuation": {
      "maxAdjacentLines": 1,
      "requiresActionInFirstUnit": true,
      "requiresDateInSecondUnit": true,
      "rejectsCompetingActionInSecondUnit": true
    },
    "ungroundedDate": {
      "disposition": "needs_review",
      "reasonCode": "action_label_not_locally_grounded"
    },
    "audit": {
      "candidateField": "sourceSegment",
      "derivedDirectory": "segments"
    },
    "semanticAdjudication": {
      "runtimeEnabled": false,
      "handoffInput": "structured segment plus deterministic candidate labels",
      "fallback": "review queue"
    },
    "flattenedTableReconstruction": {
      "enabled": true,
      "supportedFamilies": [
        "leave_return_application",
        "course_registration_by_student_year"
      ],
      "requiresLocalSectionHeaders": true,
      "boundedFragmentJoin": true,
      "maxDateFragmentLines": 6,
      "failClosedOnUnresolvedRow": true
    }
  }
}

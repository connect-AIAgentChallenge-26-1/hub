{
  "name": "hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx --env-file-if-exists=.env.local watch server/index.ts",
    "build": "npm run build:web && npm run build:extension",
    "build:web": "npm run typecheck:domain && tsc -b tsconfig.app.json tsconfig.node.json && vite build && tsx scripts/verify_client_bundle.ts dist",
    "sync:android": "npm run build:web && cap sync android",
    "build:extension": "tsc -p tsconfig.extension.json && vite build --config extension/vite.config.ts && tsx scripts/verify_client_bundle.ts dist/chrome-extension",
    "preview": "vite preview",
    "test": "vitest run --maxWorkers=2",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"api/**/*.ts\" \"extension/**/*.{ts,css,html,md}\" \"packages/**/*.{ts,json}\" \"scripts/**/*.ts\" \"*.{js,ts,json,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"api/**/*.ts\" \"extension/**/*.{ts,css,html,md}\" \"packages/**/*.{ts,json}\" \"scripts/**/*.ts\" \"*.{js,ts,json,html}\"",
    "typecheck:domain": "tsc -p packages/domain/tsconfig.json",
    "package:extension": "npm run build:extension && tsx scripts/package_chrome_extension.ts",
    "retrieve:backfill:submit": "tsx --env-file-if-exists=.env.local scripts/retrieve_backfill/submit.ts",
    "retrieve:backfill:apply": "tsx --env-file-if-exists=.env.local scripts/retrieve_backfill/apply.ts"
  },
  "dependencies": {
    "@amadda/domain": "^0.1.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.4.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.13.0",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.4.0",
    "@notionhq/client": "^5.23.2",
    "@supabase/supabase-js": "^2.110.1",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@wanteddev/wds": "3.11.0",
    "@wanteddev/wds-icon": "3.11.0",
    "@zip.js/zip.js": "^2.8.34",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.1",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-router": "^8.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^10.0.1",
    "@huggingface/transformers": "4.2.0",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.2.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "adm-zip": "^0.6.0",
    "concurrently": "^10.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.13.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@huggingface/transformers": {
      "sharp": "0.35.3"
    },
    "onnxruntime-node": {
      "adm-zip": "0.6.0"
    }
  }
}

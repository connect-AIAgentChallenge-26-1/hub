# 실제 값은 .env에만 넣는다 (.env는 gitignore 대상). 이 파일은 변수명·형식 예시만 담는다.
# CLAUDE.md 절대 원칙 8, docs/prerequisites.md 참고.

# T01 — Backend·DB 기반
APP_ENV=development
DATABASE_URL=postgresql+psycopg://hub:hub@localhost:5442/hub
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# T02 — OpenDART 수집 (발급 전까지 비워둔다)
DART_API_KEY=

# T03 — 시세·외부 근거 수집 (provider 확정 후 채운다)
MARKET_API_KEY=
NEWS_API_KEY=

# T06 — LLM (기능 C)
UPSTAGE_API_KEY=

# T14 — 개인 주문 (기능 D, 선택)
BROKER_APP_KEY=
BROKER_APP_SECRET=

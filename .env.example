# 실제 값은 .env에만 넣는다 (.env는 gitignore 대상). 이 파일은 변수명·형식 예시만 담는다.
# CLAUDE.md 절대 원칙 8, docs/prerequisites.md 참고.

# T01 — Backend·DB 기반
APP_ENV=development
DATABASE_URL=postgresql+psycopg://hub:hub@localhost:5442/hub
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# T02 — OpenDART 수집 (발급 전까지 비워둔다)
DART_API_KEY=

# T03 — 시세·외부 근거 수집 (2026-07-13 provider 결정: KIS Developers + 네이버 뉴스 검색 API)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ENV=vps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# T06 — LLM (기능 C)
UPSTAGE_API_KEY=

# T14 — 개인 주문 (기능 D, 선택)
BROKER_APP_KEY=
BROKER_APP_SECRET=

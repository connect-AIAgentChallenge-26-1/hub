# Express server (Render provides PORT automatically)
PORT=3000
# Use the exact Vercel production origin in Render.
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100
JSON_BODY_LIMIT=100kb
AGENT_INTERACTIONS_ENABLED=false

# Public frontend configuration (set this in Vercel)
VITE_API_BASE_URL=http://127.0.0.1:3000

# Server-only Supabase configuration (set these in Render only)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

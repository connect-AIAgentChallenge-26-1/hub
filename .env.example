# 서버 전용 키입니다. 절대로 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 선택: 설정하면 여러 서버 인스턴스에서도 전역 Rate Limit을 공유합니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Firebase Admin 서버 전용 서비스 계정
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Supabase 서버 전용 키 및 크론 인증값
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# 토스페이먼츠: client key만 브라우저에 공개하고 secret key는 서버에서만 사용합니다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 사용자 UUID를 외부 결제 customerKey로 직접 노출하지 않기 위한 32자 이상의 임의 문자열
TOSS_CUSTOMER_KEY_SECRET=

PORT=4000
CLIENT_URL=http://localhost:5173

GEMINI_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=

# When true, the three Gemini call sites (chat, analysis report, code/refactor
# Agent) and the GitHub-writing calls (commit-batch, doc Approve) return
# canned demo data instead of hitting the real API — for recording a demo
# without spending Gemini quota or creating real commits. Default false.
DEMO_MODE=false

# Feature flag for the original "new project from scratch" 9-step workflow
# (Agent workspace screen, sidebar step list). Default false — the UI routes
# straight to the Feature Expansion Workflow's "+ 기능 추가" screen instead.
# None of the 9-step code/routes/data model are removed; this only hides the
# screen. Set to true to bring the 9-step workflow back.
ENABLE_NEW_PROJECT_WORKFLOW=false

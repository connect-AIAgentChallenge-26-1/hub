# 서버 환경변수 — 이 파일을 server/.env 로 복사해 값을 채운다.
# server/index.js가 dotenv/config로 이 폴더의 .env를 읽는다.
# 실제 값은 절대 커밋하지 않는다 (.env는 .gitignore 대상).

# 서버 포트
PORT=3000

# Web Push (VAPID) — npx web-push generate-vapid-keys 로 생성
# VAPID_PUBLIC은 client/.env의 VITE_VAPID_PUBLIC과 같은 값이어야 한다 (한 쌍의 키)
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:you@example.com

# Supabase — 프로젝트 설정 > API 에서 확인
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # 서버 전용. 프론트 번들에 노출 금지

# 사장님 대시보드 잠금 — 배포 주소가 공개돼도 운영 화면을 막는다
OWNER_PASSCODE=

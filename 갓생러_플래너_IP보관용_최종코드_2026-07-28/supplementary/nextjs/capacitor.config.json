{
  "appId": "com.godsaeng.planner",
  "appName": "갓생러 플래너",
  "webDir": "out",
  "server": {
    "hostname": "localhost",
    "androidScheme": "https",
    "iosScheme": "capacitor"
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#ECFEFF",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    },
    "FirebaseMessaging": {
      "presentationOptions": [
        "alert",
        "badge",
        "sound"
      ]
    }
  }
}

# Google OAuth 웹 애플리케이션 사용자 인증 정보
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 카카오 Developers REST API 키 및 선택적 Client Secret
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 선택 사항: Supabase 장기기억/RAG 저장소
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 선택 사항: Firebase Cloud Messaging
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=


OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

PORT=3001
HOST=127.0.0.1
PLANNER_HTML_PATH=../frontend/플래너.html
PLANNER_CORE_PATH=../frontend/planner-core.js

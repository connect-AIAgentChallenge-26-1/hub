# Client ID only. Never put a Client Secret in a Vite environment file.
VITE_NAVER_MAPS_CLIENT_ID=
# Public URL only. Use /vision locally through Vite; use the separate Vision server URL after deployment.
# Do not add secrets here.
VITE_VISION_API_BASE_URL=/vision
# Public Express API URL. Leave blank locally because Vite proxies /api.
VITE_API_BASE_URL=

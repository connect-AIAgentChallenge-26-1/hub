# Copy this file to .env and fill in the values locally.
# Do not commit apps/api/.env.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# Server-only Supabase credentials. Never use either value in VITE_ variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORT=3000
# Add the deployed web origin here, for example https://yf560.github.io
WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Database
# Supabase 프로젝트 → Settings → Database → Connection pooling에서 복사
# 예시: postgresql://postgres:[password]@[project-ref].pooler.supabase.com:6543/postgres?schema=public&sslmode=require
DATABASE_URL=""

# Supabase Auth
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# JWT
JWT_SECRET="your-jwt-secret-key-change-in-production"

# Server
PORT=3000
NODE_ENV="development"

# Google Calendar OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/calendar/oauth-callback"

# Crawler
CRAWLER_ENABLED=true
CRAWLER_SCHEDULE="0 2 * * *"
CRAWLER_TOKEN="your-secure-token-for-crawler-api"

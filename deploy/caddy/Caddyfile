{
	# Keep Caddy's control plane local and never redirect a capability-bearing
	# HTTP path. Calendar links must be issued with an https:// origin.
	admin 127.0.0.1:2019
	auto_https disable_redirects
	log default {
		format filter {
			request>uri replace [REDACTED]
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>headers>Referer delete
			wrap json
		}
	}
}

{$NOTICEPILOT_PUBLIC_HOST} {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}

	@calendar {
		method GET HEAD
		vars_regexp {http.request.uri} ^/calendar/[A-Za-z0-9_-]{32,256}\.ics$
	}

	handle @calendar {
		reverse_proxy 127.0.0.1:3001 {
			# The public calendar endpoint is an opaque URL capability. It never
			# consumes browser credentials, cookies, or administrator headers.
			header_up -Authorization
			header_up -Cookie
			header_up -Forwarded
			header_up -Proxy-Authorization
			header_up -Referer

			@upstream_failure status 5xx
			handle_response @upstream_failure {
				header Cache-Control "no-store"
				header Content-Type "text/plain; charset=utf-8"
				header Content-Security-Policy "default-src 'none'"
				header Referrer-Policy "no-referrer"
				header Retry-After "300"
				header X-Content-Type-Options "nosniff"
				respond "temporarily unavailable" 503
			}
		}
	}

	# Do not expose /api, including the S-Lite administrator lifecycle API.
	handle {
		header Cache-Control "no-store"
		header Content-Type "text/plain; charset=utf-8"
		header Content-Security-Policy "default-src 'none'"
		header Referrer-Policy "no-referrer"
		header X-Content-Type-Options "nosniff"
		respond "not found" 404
	}

	# Intentionally no `log` directive: access logs would retain capability URLs.

	handle_errors {
		header Cache-Control "no-store"
		header Content-Type "text/plain; charset=utf-8"
		header Content-Security-Policy "default-src 'none'"
		header Referrer-Policy "no-referrer"
		header Retry-After "300"
		header X-Content-Type-Options "nosniff"
		respond "temporarily unavailable" 503
	}
}
